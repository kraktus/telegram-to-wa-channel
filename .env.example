# Copy this file to $HOME/dev/secrets/telegram-to-wa-channel/.env
# chmod 700 the directory, chmod 600 the file. Never commit the real file.

# --- Telegram ---------------------------------------------------------------
TG_BOT_TOKEN=
# Source channel: -100... id or @username
TG_SOURCE_CHAT_ID=
# Numeric Telegram user id of the admin (positive). Optional: /start captures it.
TG_ADMIN_USER_ID=

# First run only (no stored offset): replay Telegram's pending update queue
# instead of skipping to the newest post. The Bot API retains updates for
# roughly 24h; confirmed updates cannot be fetched again.
TG_BACKFILL=false

# --- WhatsApp target --------------------------------------------------------
# One of these:
WA_CHANNEL_INVITE=
# WA_CHANNEL_JID=1203630xxxxxxxxx@newsletter

# Bot's WhatsApp number: international digits only, no + (e.g. +33 6 12 34 56 78 -> 33612345678)
WA_PHONE_NUMBER=

# Default first-run linking method: pairing_code (8-char code in the admin DM)
# or qr (QR photo in the admin DM). Admins can switch at runtime with /login
# and /qr.
WA_LOGIN_METHOD=pairing_code

# --- Local state ------------------------------------------------------------
WA_AUTH_DIR=./data/wa-auth
WA_DB_PATH=./data/relay.db

# --- Relay behaviour --------------------------------------------------------
# Relay Telegram edits to WhatsApp (text and media captions). Edits that change
# the post type, or replace media without changing the caption, are skipped.
RELAY_EDITS=false
MAX_MEDIA_MB=20
# PDFs are posted one image per page (channels cannot hold documents). Longer
# PDFs post the first N pages plus a notice.
PDF_MAX_PAGES=30
SEND_DELAY_MS=1000
DRY_RUN=false

# --- Logging (stdout + Telegram admin DM, always) ---------------------------
LOG_LEVEL=info
LOG_CONSOLE=auto
LOG_DIGEST_MS=300000
LOG_RING_SIZE=1000

# Optional local health endpoint (bound to 127.0.0.1)
# HEALTH_PORT=8080

# Optional override for the secrets file location
# ENV_FILE=/path/to/.env
